# Environment Configuration for Smart Garbage Monitoring System Backend

# MongoDB Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB credentials
# For local MongoDB: mongodb://localhost:27017/garbage-monitoring
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/garbage-monitoring?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/garbage-monitoring

# Server Port
PORT=5000

# Node Environment (development, production, test)
NODE_ENV=development
